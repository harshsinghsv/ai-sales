# ==========================================
# Adaptive AI Sales & Negotiation Agent - Environment Config
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------
# 1. Agora Conversational AI & RTC
# ------------------------------------------
# Read by the Next.js app (app/api/*) and the browser. NEXT_PUBLIC_AGORA_APP_ID
# is REQUIRED — the browser cannot read a non-public variable, and it needs the
# App ID to join the RTC channel. Use the same value as AGORA_APP_ID.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# Read by the FastAPI backend. The Next.js routes fall back to these when the
# NEXT_* names above are absent, so one App ID / certificate pair serves both.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Only needed by the legacy backend-side agent join (backend/services/
# agora_convo_client.py). The Next.js /api/invite-agent route authenticates
# with the App ID + certificate instead.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_CONVO_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2

# Where the browser reaches the FastAPI backend (deal cockpit WebSocket,
# session state, deal memo).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Agora voice brain: managed_openai = Agora-hosted OpenAI (no key needed),
# custom = our FastAPI /v1/chat/completions middleware
AGORA_LLM_MODE=managed_openai
AGORA_LLM_MODEL=gpt-4.1-mini
AGORA_LLM_TEMPERATURE=0.7

# ------------------------------------------
# 2. Sarvam AI (STT, LLM, TTS)
# ------------------------------------------
SARVAM_API_KEY=
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_VOICE=meera
SARVAM_TTS_MODEL=bulbul:v3

# ------------------------------------------
# 2a. Agora-managed pipeline (RECOMMENDED - no provider keys needed)
# ------------------------------------------
# Deepgram STT + Agora-managed OpenAI LLM + MiniMax TTS all run on Agora's
# credentials. Set a vendor to "sarvam" to switch that slot to BYOK instead.
AGORA_STT_VENDOR=deepgram
AGORA_TTS_VENDOR=minimax

# Deepgram ASR. Managed mode accepts nova-2 / nova-3.
# language: "multi" (nova-3) handles Hindi/English code-switching;
# use "hi" for Hindi only, or "en-IN" for Indian English.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# MiniMax TTS. Managed mode accepts speech-2.6-turbo / speech-2.8-turbo.
# MINIMAX_VOICE_ID picks the voice - leave blank for Agora's default.
# Set it to a Hindi voice id from the MiniMax voice list for a Hindi Aarav.
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=

# ------------------------------------------
# 2b. Agora MCP
# ------------------------------------------
# Comma-separated MCP server URLs (streamable_http) the Conversational AI
# agent may call tools from. Agora's engine performs the tool calls itself.
AGORA_MCP_SERVER_URLS=

# Expose our own Deal Engine MCP server (mounted at /mcp) to the agent.
# Requires PUBLIC_BASE_URL to be reachable from Agora's cloud, so set
# PUBLIC_BASE_URL to your deployed backend URL (not localhost) for live calls.
AGORA_MCP_ENABLE_DEAL_ENGINE=true

# ------------------------------------------
# 2c. Human handoff (live RTC takeover)
# ------------------------------------------
# Public origin of the Next.js app. escalate_to_human builds a link here that a
# specialist opens to join the buyer's live Agora RTC channel.
HUMAN_HANDOFF_BASE_URL=http://localhost:3000
HUMAN_AGENT_RTC_UID=7777

# Sarvam settings for Agora's native ASR/TTS vendor slots (BYOK only). The Agora `sarvam`
# TTS vendor takes a bulbul:v3 speaker id (anushka, abhilash, karun, hitesh,
# manisha, vidya, arya) and a BCP-47 target language — a different namespace
# from SARVAM_TTS_VOICE above, which drives our own /v1/audio/speech shim.
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=abhilash
SARVAM_TTS_TARGET_LANGUAGE=hi-IN
SARVAM_TTS_SAMPLE_RATE=24000

# ------------------------------------------
# 3. HubSpot CRM
# ------------------------------------------
HUBSPOT_ACCESS_TOKEN=

# ------------------------------------------
# 4. Google Calendar
# ------------------------------------------
GOOGLE_CALENDAR_CREDENTIALS=

# ------------------------------------------
# 5. Human Escalation (Slack Incoming Webhook)
# ------------------------------------------
SLACK_WEBHOOK_URL=
